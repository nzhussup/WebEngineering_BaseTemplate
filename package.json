{
  "name": "web-engineering-playgrounds",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --names web,api --prefix-colors cyan,green \"npm run dev --workspace @playground/web\" \"npm run dev --workspace @playground/api\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"apps/**/*.{js,jsx,ts,tsx,json}\" \"*.{js,json,yaml}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"apps/**/*.{js,jsx,ts,tsx,json}\" \"*.{js,json,yaml}\" \".github/**/*.yml\"",
    "check": "npm run lint && npm run format:check && npm run build",
    "prepare": "husky",
    "lint:staged": "lint-staged"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "9.2.1",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-standard-with-typescript": "43.0.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "16.6.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "6.6.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "tsx": "4.20.6",
    "typescript": "5.3.3",
    "vite": "8.3.1"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "9.0.9"
    }
  }
}
